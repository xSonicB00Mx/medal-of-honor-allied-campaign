menu "ac_lighting" 960 540 NONE 0
virtualres 1
widecanvas
fullscreen 1
bgfill 0 0 0 1
borderstyle NONE
widescreenbackground "textures/ac/menu_background"

resource
Label
{
name "heading"
dontlocalize
title "LIGHTING & PARTICLES"
rect 44 34 872 36
font facfont-20
fgcolor 0.91 0.86 0.7 1
bgcolor 0 0 0 0
borderstyle NONE

}

resource
Label
{
name "modelLightingLabel"
dontlocalize
title "Local model lighting"
rect 64 130 760 30
font ac-courier-16
fgcolor 0.91 0.86 0.7 1
bgcolor 0 0 0 0
borderstyle NONE

}

resource
CheckBox
{
name "modelLighting"
dontlocalize
title ""
rect 854 130 28 28
font ac-courier-14
fgcolor 0.91 0.86 0.7 1
bgcolor 0 0 0 0
borderstyle NONE
linkcvar r_acModelLighting
checked_shader textures/menu/checkbox_checked
unchecked_shader textures/menu/checkbox_unchecked
}

resource
Label
{
name "modelLightingHint"
dontlocalize
title "Models respond to the lighting in their immediate surroundings."
rect 64 166 824 28
font ac-courier-12
fgcolor 0.91 0.86 0.7 1
bgcolor 0 0 0 0
borderstyle NONE

}

resource
Label
{
name "dynamicLightingLabel"
dontlocalize
title "Occluded dynamic lights"
rect 64 228 760 30
font ac-courier-16
fgcolor 0.91 0.86 0.7 1
bgcolor 0 0 0 0
borderstyle NONE

}

resource
CheckBox
{
name "dynamicLighting"
dontlocalize
title ""
rect 854 228 28 28
font ac-courier-14
fgcolor 0.91 0.86 0.7 1
bgcolor 0 0 0 0
borderstyle NONE
linkcvar r_acDynamicLighting
checked_shader textures/menu/checkbox_checked
unchecked_shader textures/menu/checkbox_unchecked
}

resource
Label
{
name "dynamicLightingHint"
dontlocalize
title "Walls and moving doors block nearby weapon and explosion lights."
rect 64 264 824 28
font ac-courier-12
fgcolor 0.91 0.86 0.7 1
bgcolor 0 0 0 0
borderstyle NONE

}

resource
Label
{
name "softParticlesLabel"
dontlocalize
title "Lit soft particles"
rect 64 326 760 30
font ac-courier-16
fgcolor 0.91 0.86 0.7 1
bgcolor 0 0 0 0
borderstyle NONE

}

resource
CheckBox
{
name "softParticles"
dontlocalize
title ""
rect 854 326 28 28
font ac-courier-14
fgcolor 0.91 0.86 0.7 1
bgcolor 0 0 0 0
borderstyle NONE
linkcvar r_acSoftParticles
checked_shader textures/menu/checkbox_checked
unchecked_shader textures/menu/checkbox_unchecked
}

resource
Label
{
name "softParticlesHint"
dontlocalize
title "Diffuse clouds receive lighting and blend softly at solid surfaces."
rect 64 362 824 28
font ac-courier-12
fgcolor 0.91 0.86 0.7 1
bgcolor 0 0 0 0
borderstyle NONE

}

resource
Label
{
name "applyHint"
dontlocalize
title "Changes apply immediately across all campaigns."
rect 208 476 550 32
font ac-courier-12
fgcolor 0.91 0.86 0.7 1
bgcolor 0 0 0 0
borderstyle NONE

}

resource
Button
{
name "back"
dontlocalize
title "Back"
rect 44 476 140 32
font ac-courier-16
fgcolor 0.91 0.86 0.7 1
bgcolor 0 0 0 0
borderstyle NONE
stuffcommand "popmenu 0"
}

resource
Button
{
name "lightingDefaults"
dontlocalize
title "Defaults"
rect 772 476 144 32
font ac-courier-16
fgcolor 0.91 0.86 0.7 1
bgcolor 0 0 0 0
borderstyle NONE
stuffcommand "set r_acModelLighting 1; set r_acDynamicLighting 1; set r_acSoftParticles 1"
}
end.
