fgcolor 0.91 0.86 0.7 1
bgcolor 0.12 0.14 0.12 1
borderstyle NONE
font facfont-20
shader textures/menu/slider
linkcvar ac_menu_scale
slidertype float
setrange 0.65 1
stepsize 0.05
}

resource
Field
{
name "menuValue"
title ""
rect 533 169 94 26
fgcolor 0.91 0.86 0.7 1
bgcolor 0.12 0.14 0.12 1
borderstyle NONE
font facfont-20
linkcvar ac_menu_scale
borderstyle INDENT_BORDER
}

