menu "ac_scaling" 640 480 NONE 0

virtualres 1

fullscreen 1

bgcolor 0.055 0.065 0.06 1

bgfill 0.02 0.025 0.02 1

borderstyle NONE

resource
Label
{
name "heading"
title "ALLIED CAMPAIGN | Display"
rect 30 24 580 35
fgcolor 0.91 0.86 0.7 1
bgcolor 0.12 0.14 0.12 1
borderstyle NONE
font facfont-20

}

resource
Label
{
name "intro"
title "Adjust menus and HUD to your screen."
rect 30 62 580 25
fgcolor 0.91 0.86 0.7 1
bgcolor 0.12 0.14 0.12 1
borderstyle NONE
font facfont-20

}

resource
Label
{
name "autoLabel"
title "Automatic scaling"
rect 30 117 300 26
fgcolor 0.91 0.86 0.7 1
bgcolor 0.12 0.14 0.12 1
borderstyle NONE
font facfont-20

}

resource
CheckBox
{
name "auto"
title ""
rect 438 117 30 26
fgcolor 0.91 0.86 0.7 1
bgcolor 0.12 0.14 0.12 1
borderstyle NONE
font facfont-20
linkcvar ac_ui_auto
checked_shader textures/menu/checkbox_checked
unchecked_shader textures/menu/checkbox_unchecked
}

resource
Label
{
name "menuLabel"
title "Menu and font size"
rect 30 156 300 26
fgcolor 0.91 0.86 0.7 1
bgcolor 0.12 0.14 0.12 1
borderstyle NONE
font facfont-20

}

resource
Slider
{
name "menuSlider"
title ""
